# ============================================
# AI API 配置
# ============================================

# 阿里云百炼 API 配置
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwq-32b

# OpenAI 兼容模式配置（使用阿里云百炼）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwq-32b

# Embedding 模型配置
EMBEDDING_MODEL=text-embedding-v1
OPENAI_EMBEDDING_MODEL=text-embedding-v1

# ============================================
# LLM 配置
# ============================================

LLM_MODEL=qwq-32b
LLM_TEMPERATURE=0.1

# ============================================
# ChromaDB 配置
# ============================================

CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=recipes

# ============================================
# Agent 配置
# ============================================

MAX_ITERATIONS=5
VERBOSE=true

# ============================================
# 检索配置
# ============================================

TOP_K=5

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ============================================
# V3 增强功能配置
# ============================================

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DATABASE=diet_agent_v3

# Cross-Encoder 重排序配置
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=10
RERANKER_SCORE_THRESHOLD=0.0

# 上下文压缩配置
CONTEXT_COMPRESSION_STRATEGY=hybrid
CONTEXT_WINDOW_SIZE=5
CONTEXT_MAX_TOKENS=2000

# ============================================
# Phase 4: 可观测性 + Streaming 配置
# ============================================

# FastAPI 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# 结构化日志（默认启用）
STRUCTURED_LOG_ENABLED=true

# Langfuse 可观测性（默认禁用，填入密钥后设为 true 启用）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# Phase 5: 性能优化配置
# ============================================

# LLM 后端选择: dashscope_multimodal / dashscope_openai_compat
LLM_BACKEND=dashscope_multimodal
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 快速相关性过滤（embedding 替代 LLM 逐篇判断）
FAST_RELEVANCE_ENABLED=true
FAST_RELEVANCE_THRESHOLD=0.3

# Self-RAG 精简模式（合并幻觉+有用性为单次调用）
SELF_RAG_LITE=true

# LLM 响应缓存
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=./cache/llm_cache.db
